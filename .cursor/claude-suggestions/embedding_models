### 6. Batch Processing for Initial Data

For your initial data import from the CSV files you've shared, I recommend a batch processing approach:

```javascript
// Example batch processing function
async function batchEmbedGuidelines() {
  try {
    // Fetch guidelines without embeddings
    const { data: guidelines, error } = await supabase
      .from('guidelines')
      .select('id, content')
      .is('content_embedding', null);
    
    if (error) throw error;
    
    // Process in batches of 10 to avoid rate limits
    for (let i = 0; i < guidelines.length; i += 10) {
      const batch = guidelines.slice(i, i + 10);
      await Promise.all(batch.map(async (guideline) => {
        const embedding = await generateEmbedding(guideline.content);
        return supabase
          .from('guidelines')
          .update({ content_embedding: embedding })
          .eq('id', guideline.id);
      }));
      
      console.log(`Processed batch ${i/10 + 1} of ${Math.ceil(guidelines.length/10)}`);
    }
    
    console.log('All guidelines embedded successfully');
  } catch (error) {
    console.error('Error in batch embedding:', error);
    throw error;
  }
}
```

