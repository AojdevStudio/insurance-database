# Application Environment
NODE_ENV=development
PORT=3000
HOST=localhost

# Database Connection (Required for Prisma)
# For local development with Docker/Supabase
DATABASE_URL="postgresql://postgres:postgres@localhost:54321/postgres?schema=public"
# For local development with Docker Compose
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/insurance_db"
# For Supabase cloud
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_INSTANCE.supabase.co:5432/postgres?schema=public"

# Supabase Configuration
# Local Supabase configuration
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your_local_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Supabase cloud configuration
# SUPABASE_URL=your_cloud_supabase_url
# SUPABASE_ANON_KEY=your_cloud_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_cloud_service_role_key

# OpenAI Configuration (for vector embeddings)
OPENAI_API_KEY=your_openai_api_key
OPENAI_ORG_ID=your-org-id-here  # Optional
OPENAI_MODEL=text-embedding-ada-002
OPENAI_MAX_RETRIES=3
OPENAI_RATE_LIMIT_RPM=200
OPENAI_TIMEOUT_MS=30000

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TTL=3600

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
ENABLE_PRISMA_SERVICES=true
ENABLE_VECTOR_SEARCH=true
ENABLE_REDIS_CACHE=true