{
  "name": "insurance-database",
  "version": "1.0.0",
  "description": "Insurance database system with CSV import capabilities",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:perf": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testMatch='**/*.perf.test.ts'",
    "test:prisma": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=prisma",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=integration",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=unit",
    "test:transactions": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=transactions",
    "test:schema-validation": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=schema",
    "test:vector-search": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=vector",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "process-json": "ts-node src/scripts/process-json.ts",
    "process-json:build": "node dist/scripts/process-json.js",
    "prisma:pull": "prisma db pull",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:format": "prisma format",
    "db:pull-generate": "npm run prisma:pull && npm run prisma:generate",
    "db:validate": "ts-node scripts/validate-db-connection.ts",
    "db:check-drift": "ts-node scripts/check-schema-drift.ts",
    "build:prisma": "npm run prisma:generate && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@supabase/supabase-js": "^2.49.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/express-rate-limit": "^5.1.3",
    "@types/redis": "^4.0.10",
    "@types/uuid": "^10.0.0",
    "ajv": "^8.17.1",
    "axios": "^1.8.4",
    "cors": "^2.8.5",
    "csv-parse": "^4.16.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "franc": "^6.2.0",
    "helmet": "^8.1.0",
    "node-fetch": "^3.3.2",
    "openai": "^4.28.0",
    "p-limit": "^5.0.0",
    "p-retry": "^5.1.2",
    "redis": "^4.7.0",
    "uuid": "^11.1.0",
    "winston": "^3.11.0",
    "yarn": "^1.22.22",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prisma": "^6.5.0",
    "supabase": "^2.20.3",
    "supertest": "^7.1.0",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "tsc-watch": "^6.2.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "eslint.config.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  }
}
