generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Insurance carrier information
model InsuranceCarrier {
  id                        BigInt                      @id @default(autoincrement())
  name                      String
  created_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  
  documents                 CarrierDocument[]
  aliases                   CarrierAlias[]
  procedureRequirements     CarrierProcedureRequirement[]
  credentialingRequirements CredentialingRequirement[]
  plans                     InsurancePlan[]
  medicareAdvantagePlans    MedicareAdvantagePlan[]
  networkRelationships      NetworkCarrierRelationship[]
  processingCaveats         ProcessingCaveat[]

  @@map("insurance_carriers")
}

/// Insurance network information (umbrella organizations)
model InsuranceNetwork {
  id                         BigInt                       @id @default(autoincrement())
  network_name               String                       @map("network_name")
  contact_phone              String?                      @map("contact_phone")
  contact_email              String?                      @map("contact_email")
  resource_url               String?                      @map("resource_url")
  notes                      String?
  created_at                 DateTime?                    @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime?                    @default(now()) @db.Timestamptz(6)
  
  credentialingRequirements  CredentialingRequirement[]
  carrierRelationships       NetworkCarrierRelationship[]
  processingCaveats          ProcessingCaveat[]

  @@map("insurance_networks")
}

/// Dental procedure codes and descriptions
model Procedure {
  id                      BigInt                        @id @default(autoincrement())
  procedure_code          String                        @unique @map("procedure_code")
  description             String
  category                String?
  created_at              DateTime?                     @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?                     @default(now()) @db.Timestamptz(6)
  
  carrierRequirements     CarrierProcedureRequirement[]

  @@map("procedures")
}

/// This model contains carrier name aliases for fuzzy matching
model CarrierAlias {
  id         BigInt           @id @default(autoincrement())
  carrier_id BigInt?
  alias_name String           @unique @map("alias_name")
  created_at DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at DateTime?        @default(now()) @db.Timestamptz(6)
  
  carrier    InsuranceCarrier? @relation(fields: [carrier_id], references: [id])

  @@map("carrier_aliases")
}

/// Documentation uploaded for specific insurance carriers
model CarrierDocument {
  id                BigInt                @id @default(autoincrement())
  carrier_id        BigInt?
  filename          String
  metadata          Json?                 @default("{}")
  total_pages       Int?                  @default(0)
  processed_date    DateTime?             @default(now()) @db.Timestamptz(6)
  created_at        DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?             @default(now()) @db.Timestamptz(6)
  
  carrier           InsuranceCarrier?     @relation(fields: [carrier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pages             DocumentPage[]
  procedures        DocumentProcedure[]

  @@map("carrier_documents")
}

/// Individual pages from carrier documents with extracted content
model DocumentPage {
  id            BigInt           @id @default(autoincrement())
  document_id   BigInt?
  page_number   Int
  content       String
  created_at    DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?        @default(now()) @db.Timestamptz(6)
  
  document      CarrierDocument? @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([document_id, page_number])
  @@map("document_pages")
}

/// Procedures mentioned in carrier documents
model DocumentProcedure {
  id                      BigInt           @id @default(autoincrement())
  document_id             BigInt?
  procedure_code          String
  description             String?
  submission_requirements String?
  documentation_required  Boolean?         @default(false)
  created_at              DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?        @default(now()) @db.Timestamptz(6)
  
  document                CarrierDocument? @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([document_id, procedure_code])
  @@map("document_procedures")
}

/// Requirements for specific procedures by carrier
model CarrierProcedureRequirement {
  id                     BigInt           @id @default(autoincrement())
  carrier_id             BigInt?
  procedure_id           BigInt?
  documentation_required String?
  frequency_limitation   String?
  age_restrictions       String?
  other_limitations      String?
  created_at             DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?        @default(now()) @db.Timestamptz(6)
  
  carrier                InsuranceCarrier? @relation(fields: [carrier_id], references: [id])
  procedure              Procedure?       @relation(fields: [procedure_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([carrier_id, procedure_id])
  @@map("carrier_procedure_requirements")
}

/// Credentialing requirements for networks and carriers
model CredentialingRequirement {
  id                   BigInt              @id @default(autoincrement())
  network_id           BigInt?
  carrier_id           BigInt?
  requirement_type     String?
  description          String
  documentation_needed String?
  timeframe            String?
  created_at           DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?           @default(now()) @db.Timestamptz(6)
  
  network              InsuranceNetwork?   @relation(fields: [network_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  carrier              InsuranceCarrier?   @relation(fields: [carrier_id], references: [id])

  @@map("credentialing_requirements")
}

/// Insurance plan information
model InsurancePlan {
  id                    BigInt           @id @default(autoincrement())
  carrier_id            BigInt?
  plan_name             String           @map("plan_name")
  plan_type             String?          @map("plan_type")
  is_medicare_advantage Boolean?         @default(false) @map("is_medicare_advantage")
  notes                 String?
  created_at            DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?        @default(now()) @db.Timestamptz(6)
  
  carrier               InsuranceCarrier? @relation(fields: [carrier_id], references: [id])

  @@map("insurance_plans")
}

/// Medicare Advantage plan information
model MedicareAdvantagePlan {
  id             BigInt           @id @default(autoincrement())
  carrier_id     BigInt?
  plan_name      String           @map("plan_name")
  states_covered String?          @map("states_covered")
  effective_date DateTime?        @db.Date @map("effective_date")
  notes          String?
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?        @default(now()) @db.Timestamptz(6)
  
  carrier        InsuranceCarrier? @relation(fields: [carrier_id], references: [id])

  @@map("medicare_advantage_plans")
}

/// Relationships between networks and carriers
model NetworkCarrierRelationship {
  id                    BigInt              @id @default(autoincrement())
  network_id            BigInt?
  carrier_id            BigInt?
  effective_date        DateTime?           @db.Date @map("effective_date")
  termination_date      DateTime?           @db.Date @map("termination_date")
  special_notes         String?             @map("special_notes")
  verification_required Boolean?            @default(false) @map("verification_required")
  created_at            DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?           @default(now()) @db.Timestamptz(6)
  
  network               InsuranceNetwork?   @relation(fields: [network_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  carrier               InsuranceCarrier?   @relation(fields: [carrier_id], references: [id])

  @@unique([network_id, carrier_id])
  @@map("network_carrier_relationships")
}

/// Record of uploaded JSON files
model JsonUpload {
  id          BigInt    @id @default(autoincrement())
  file_name   String    @map("file_name")
  content     Json
  uploaded_at DateTime? @default(now()) @db.Timestamptz(6) @map("uploaded_at")

  @@index([file_name], map: "idx_json_uploads_file_name")
  @@map("json_uploads")
}

/// Special processing notes and issues for networks/carriers
model ProcessingCaveat {
  id                 BigInt              @id @default(autoincrement())
  network_id         BigInt?
  carrier_id         BigInt?
  caveat_type        String?             @map("caveat_type")
  description        String
  impact_level       String?             @map("impact_level")
  workaround         String?
  created_at         DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?           @default(now()) @db.Timestamptz(6)
  
  network            InsuranceNetwork?   @relation(fields: [network_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  carrier            InsuranceCarrier?   @relation(fields: [carrier_id], references: [id])

  @@map("processing_caveats")
}